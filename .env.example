# Copy to .env.local. Every value marked FAKE can stay as is: the app then uses the
# default story, placeholder images, the built-in title catalog and an embedded database.

# auto = try the AI and fall back | default = never call the AI | ai = same as auto, without the host's built-in toggle
STORY_MODE=auto

# Supabase. While DATABASE_URL contains FAKE, data lives in an embedded Postgres (.data/pglite).
NEXT_PUBLIC_SUPABASE_URL=https://FAKE.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=FAKE-publishable-replace-me
SUPABASE_SECRET_KEY=FAKE-secret-replace-me
DATABASE_URL=postgresql://FAKE

# Signs the cookie that identifies a browser (embedded mode). Use a long random value in production.
COOKIE_SECRET=FAKE-cookie-secret-for-local-development-only

# Hosts log in with this password to open and control rooms. Players never need it.
# FAKE or empty = no login with the embedded database, and no hosting at all with a real one.
# With a real database it must have at least 16 characters. Changing it logs every host out.
HOST_PASSWORD=FAKE-host-password

ANTHROPIC_API_KEY=sk-ant-FAKE-replace-me
GEMINI_API_KEY=FAKE-gemini-replace-me
TMDB_API_KEY=FAKE-tmdb-replace-me
GOOGLE_BOOKS_API_KEY=FAKE-google-books-replace-me
# Only for a deployment that Inngest's cloud can call. `pnpm dev` ignores them.
INNGEST_EVENT_KEY=FAKE-inngest-event
INNGEST_SIGNING_KEY=FAKE-inngest-signing
# How many jobs may run at once. Must not be above the limit of the Inngest plan, or Inngest rejects the app. Empty = 5 (free plan).
INNGEST_CONCURRENCY=
# Set to 1 when `pnpm dev:inngest` is running. Otherwise jobs run inside the web server.
INNGEST_DEV=

# Optional overrides
GEMINI_IMAGE_MODEL=
GEMINI_FALLBACK_IMAGE_MODEL=
SESSION_BUDGET_USD=3
